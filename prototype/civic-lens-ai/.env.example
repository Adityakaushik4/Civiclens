LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

STT_PROVIDER=gemini
STT_API_KEY=your_stt_api_key_here
STT_MODEL=gemini-3.6-flash
MAX_AUDIO_SIZE_MB=10

VISION_PROVIDER=gemini
VISION_API_KEY=your_vision_api_key_here
VISION_MODEL=gemini-3.6-flash
MAX_IMAGE_SIZE_MB=10

CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.50

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://civic_user:civic_password@localhost:5432/civiclens
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
